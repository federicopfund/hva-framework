{
 "cells": [
  {
   "kind": 1,
   "value": "# HybridAgent — Exploración interactiva\n\nEste notebook carga el paclet HVA y recorre las funciones principales de `HybridAgent`:\n`AgentId`, accessors, actualizaciones inmutables y hash estructural.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## 1 · Cargar el paclet",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "PacletDirectoryLoad[\"/workspaces/hva-framework/paclet\"];\nNeeds[\"HVA`\"]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1779007959265,
     "endTime": 1779007959392
    },
    "executionOrder": 26,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "## 2 · Construir un agente de prueba",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Agente termostat mínimo *)\nSpec = HybridAgent[\"thermostat\",\n  States       -> {\"off\", \"on\"},\n  Vars         -> {temp},\n  Dynamics     -> <|\n    \"off\" -> {Derivative[1][temp] == 0},\n    \"on\"  -> {Derivative[1][temp] == 5 - temp}\n  |>,\n  Guards       -> {\n    <|\"from\" -> \"off\", \"to\" -> \"on\",  \"condition\" -> temp < 18|>,\n    <|\"from\" -> \"on\",  \"to\" -> \"off\", \"condition\" -> temp > 22|>\n  },\n  Invariants   -> {0 <= temp <= 30},\n  InitialState -> \"off\",\n  InitialValues -> <|temp -> 15|>\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wrow><w></w><w>HybridAgent</w><wrow><w></w><wb>[</wb><wrow><w></w><wb></wb><wrow><w></w><wrow><w></w><w>id</w><w class=\"symbol\"></w><w>thermostat</w></wrow><w>,</w><wrow><w></w><w>states</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wrow><w></w><w>off</w><w>,</w><w>on</w></wrow><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>vars</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><w>temp</w><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>time</w><w class=\"symbol\"></w><w>t</w></wrow><w>,</w><wrow><w></w><w>dynamics</w><w class=\"symbol\"></w><wrow><w></w><wb></wb><wrow><w></w><wrow><w></w><w>off</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wrow><w></w><wsup><w></w><w>temp</w><w><w class=\"small-symbol\"></w></w></wsup><w class=\"symbol\"></w><w>0</w></wrow><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>on</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wrow><w></w><wsup><w></w><w>temp</w><w><w class=\"small-symbol\"></w></w></wsup><w class=\"symbol\"></w><wrow><w></w><w>5</w><w>-</w><w>temp</w></wrow></wrow><wb>}</wb></wrow></wrow></wrow><wb></wb></wrow></wrow><w>,</w><wrow><w></w><w>guards</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wrow><w></w><wrow><w></w><wb></wb><wrow><w></w><wrow><w></w><w>from</w><w class=\"symbol\"></w><w>off</w></wrow><w>,</w><wrow><w></w><w>to</w><w class=\"symbol\"></w><w>on</w></wrow><w>,</w><wrow><w></w><w>condition</w><w class=\"symbol\"></w><wrow><w></w><w>temp</w><w>&lt;</w><w>18</w></wrow></wrow></wrow><wb></wb></wrow><w>,</w><wrow><w></w><wb></wb><wrow><w></w><wrow><w></w><w>from</w><w class=\"symbol\"></w><w>on</w></wrow><w>,</w><wrow><w></w><w>to</w><w class=\"symbol\"></w><w>off</w></wrow><w>,</w><wrow><w></w><w>condition</w><w class=\"symbol\"></w><wrow><w></w><w>temp</w><w>&gt;</w><w>22</w></wrow></wrow></wrow><wb></wb></wrow></wrow><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>invariants</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wrow><w></w><w>0</w><w>≤</w><w>temp</w><w>≤</w><w>30</w></wrow><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>contract</w><w class=\"symbol\"></w><wrow><w></w><w>Contract</w><wrow><w></w><wb>[</wb><wrow><w></w><wb></wb><wrow><w></w><wrow><w></w><w>assumes</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>guarantees</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wb>}</wb></wrow></wrow></wrow><wb></wb></wrow><wb>]</wb></wrow></wrow></wrow><w>,</w><wrow><w></w><w>handlers</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>initialState</w><w class=\"symbol\"></w><w>off</w></wrow><w>,</w><wrow><w></w><w>initialValues</w><w class=\"symbol\"></w><wrow><w></w><wb></wb><wrow><w></w><w>temp</w><w class=\"symbol\"></w><w>15</w></wrow><wb></wb></wrow></wrow><w>,</w><wrow><w></w><w>currentState</w><w class=\"symbol\"></w><w>off</w></wrow><w>,</w><wrow><w></w><w>valuation</w><w class=\"symbol\"></w><wrow><w></w><wb></wb><wrow><w></w><w>temp</w><w class=\"symbol\"></w><w>15</w></wrow><wb></wb></wrow></wrow><w>,</w><wrow><w></w><w>mailbox</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wb>}</wb></wrow></wrow><w>,</w><wrow><w></w><w>trace</w><w class=\"symbol\"></w><wrow><w></w><wb>{</wb><wb>}</wb></wrow></wrow></wrow><wb></wb></wrow><wb>]</wb></wrow></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "HybridAgent[Association[\"id\" -> \"thermostat\", \"states\" -> {\"off\", \"on\"}, \"vars\" -> {temp}, \"time\" -> t, \"dynamics\" -> Association[\"off\" -> {Derivative[1][temp] == 0}, \"on\" -> {Derivative[1][temp] == 5 - temp}], \"guards\" -> {Association[\"from\" -> \"off\", \"to\" -> \"on\", \"condition\" -> temp < 18], Association[\"from\" -> \"on\", \"to\" -> \"off\", \"condition\" -> temp > 22]}, \"invariants\" -> {0 <= temp <= 30}, \"contract\" -> Contract[Association[\"assumes\" -> {}, \"guarantees\" -> {}]], \"handlers\" -> {}, \"initialState\" -> \"off\", \"initialValues\" -> Association[temp -> 15], \"currentState\" -> \"off\", \"valuation\" -> Association[temp -> 15], \"mailbox\" -> {}, \"trace\" -> {}]]",
       "mime": "text/plain"
      }
