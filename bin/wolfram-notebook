#!/bin/bash
# wolfram-notebook — wrapper for njpipeorgan.wolfram-language-notebook VS Code extension.
#
# The extension starts the kernel with:
#   wolframscript -code 'ToExpression["zmqPort=XXXXX;"<>Uncompress["..."]]'
# and then connects to localhost:XXXXX via ZMQ.
#
# The kernel binds ZMQ to 127.0.0.1:XXXXX (loopback) inside the container.
# Docker -p port mapping cannot reach a loopback-bound socket, so we use
# --network host to share the dev container's network namespace — making
# 127.0.0.1 inside the Docker container identical to 127.0.0.1 in the dev container.

exec docker run --rm -i \
  --network host \
  -v /workspaces/hva-framework:/workspaces/hva-framework \
  -w /workspaces/hva-framework \
  hva:latest \
  /usr/bin/wolframscript "$@"
