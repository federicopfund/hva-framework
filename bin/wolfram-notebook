#!/bin/bash
# wolfram-notebook — wrapper para el kernel Jupyter de Wolfram Language.
#
# Jupyter llama: wolfram-notebook -ZMQApplication ZMQKernelApp /path/to/connection_file.json
#
# WolframKernel (no wolframscript) es el binario que soporta -ZMQApplication.
# El connection_file está en el runtime de Jupyter del dev container; lo montamos
# para que el contenedor pueda leerlo.
# --network host comparte el namespace de red del dev container, por lo que
# los puertos ZMQ enlazados dentro del contenedor son accesibles directamente.

JUPYTER_RUNTIME_DIR="$(python3 -c 'import jupyter_core.paths; print(jupyter_core.paths.jupyter_runtime_dir())' 2>/dev/null \
  || echo "/home/codespace/.local/share/jupyter/runtime")"

exec docker run --rm -i \
  --network host \
  -v /workspaces/hva-framework:/workspaces/hva-framework \
  -v "${JUPYTER_RUNTIME_DIR}:${JUPYTER_RUNTIME_DIR}" \
  -w /workspaces/hva-framework \
  hva:latest \
  /usr/local/bin/WolframKernel "$@"
