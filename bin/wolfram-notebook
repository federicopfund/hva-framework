#!/bin/bash
# wolfram-notebook — wrapper for njpipeorgan.wolfram-language-notebook VS Code extension.
#
# The extension starts the kernel with:
#   wolfram -code 'ToExpression["zmqPort=XXXXX;"<>Uncompress["..."]]'
# and then connects to localhost:XXXXX via ZMQ.
#
# Because the kernel runs inside a nested Docker container, we must expose that
# port with -p XXXXX:XXXXX so the extension (running in the dev container) can
# reach it.

ZMQPORT=""
for arg in "$@"; do
  if [[ "$arg" =~ zmqPort=([0-9]+) ]]; then
    ZMQPORT="${BASH_REMATCH[1]}"
    break
  fi
done

PORT_ARGS=()
if [[ -n "$ZMQPORT" ]]; then
  PORT_ARGS=(-p "${ZMQPORT}:${ZMQPORT}")
fi

exec docker run --rm -i \
  "${PORT_ARGS[@]}" \
  -v /workspaces/hva-framework:/workspaces/hva-framework \
  -w /workspaces/hva-framework \
  hva:latest \
  /usr/bin/wolframscript "$@"
