# build: ignorar directorio excepto el artefacto .paclet publicado
build/*
!build/HVA-*.paclet
!build/HVA-*/
.wolfram-paclets/
.vscode/
/bin/wl_kernel.py
# notebooks: ignorar todos los archivos Jupyter y Wolfram notebook
*.ipynb
*.wlnb
/notebooks/
/pyrightconfig.json
/docs/documenta/HVA_Formalismo_Matematico.docx
/docs/documenta/HVA_Spec_Tecnica_final.docx
# .claude/ is tracked only in develop; see .gitattributes on main for merge exclusion
